# Rust
/target
/target-android
**/*.rs.bk
# Cargo.lock IS committed. These are applications, so exact audited dependency
# versions are pinned for reproducible, supply-chain-safe builds.

# Fuzzing artefacts
/crates/metascrub/fuzz/target
/crates/metascrub/fuzz/corpus
/crates/metascrub/fuzz/artifacts

# Never commit somebody's files, cleaned or otherwise
*.clean.*
/samples
/scratch

# Built native libraries (produced by build-apk.sh)
android/app/src/main/jniLibs/

# Built Rust core for the Ubuntu Touch click (produced by ubuntu-touch/build-ffi.sh)
ubuntu-touch/metascrub/rustlib/

# Clickable build output
ubuntu-touch/metascrub/build/

# Built click packages
*.click
